# ==============================================================================
# n8n & PostgreSQL Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# IMPORTANT:
# 1. Never commit your real .env file into version control.
# 2. Back up your N8N_ENCRYPTION_KEY safely. If lost, existing credentials
#    stored in n8n cannot be decrypted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host & Networking Configuration
# ------------------------------------------------------------------------------
# Host port to expose n8n on (default: 5678)
N8N_PORT=5678

# Hostname n8n runs under (e.g. localhost or n8n.yourdomain.com)
N8N_HOST=localhost

# Protocol (http or https). Set to https if terminating SSL at a reverse proxy.
N8N_PROTOCOL=http

# Public webhook callback base URL (must end with a trailing slash)
# For local use: http://localhost:5678/
# For production: https://n8n.yourdomain.com/
N8N_WEBHOOK_URL=http://localhost:5678/

# ------------------------------------------------------------------------------
# 2. Timezone & Locale
# ------------------------------------------------------------------------------
# Determines when Schedule and Cron trigger nodes execute (e.g., UTC, America/New_York, Europe/London, Asia/Kathmandu)
GENERIC_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 3. Security & Encryption
# ------------------------------------------------------------------------------
# 32+ character random encryption key used to encrypt credentials in the database.
# Generate on Linux/macOS: openssl rand -hex 32
# Generate on Windows PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
N8N_ENCRYPTION_KEY=replace_with_a_secure_random_key_at_least_32_chars

# Set to true when serving over HTTPS with valid SSL/TLS certificates
N8N_SECURE_COOKIE=false

# Prevent malicious code inside Code nodes from reading container host environment variables
N8N_BLOCK_ENV_ACCESS_IN_NODE=true

# Enforce strict file permissions for internal n8n configuration
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# Disable telemetry and crash reporting back to n8n.io
N8N_DIAGNOSTICS_ENABLED=false

# ------------------------------------------------------------------------------
# 4. PostgreSQL Database Credentials
# ------------------------------------------------------------------------------
# Database user and database name (accessible inside the Docker network)
POSTGRES_USER=n8n
POSTGRES_DB=n8n

# Strong password for PostgreSQL backend
POSTGRES_PASSWORD=replace_with_a_strong_database_password

# ------------------------------------------------------------------------------
# 5. Execution History & Database Pruning
# ------------------------------------------------------------------------------
# Enable automated pruning to prevent the database from growing indefinitely
EXECUTIONS_DATA_PRUNE=true

# Retention period in hours before executions are purged (336 hours = 14 days)
EXECUTIONS_DATA_MAX_AGE=336

# Which execution logs to persist (options: all, none)
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all

# ------------------------------------------------------------------------------
# 6. Task Runners & Resource Limits
# ------------------------------------------------------------------------------
# Execution timeout in seconds for runner tasks
N8N_RUNNERS_TASK_TIMEOUT=300

# Offload manual UI test executions to worker processes
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true

# Prevent cloning bare Git repositories in Git node
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# Maximum decompressed archive size in bytes (2 GB)
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648

# Maximum entries allowed in decompression operations
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000

# ------------------------------------------------------------------------------
# 7. Community Nodes & Custom Extensions
# ------------------------------------------------------------------------------
# Allow installing community packages from npm via Settings -> Community nodes
N8N_COMMUNITY_PACKAGES_ENABLED=true
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=true
N8N_UNVERIFIED_PACKAGES_ENABLED=true
